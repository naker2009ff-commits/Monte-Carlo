# Бэктест VaR 95% прогноз на каждый день по предыдущим 250 дням
windows = sliding_window_view(r_oil, 250)
past = windows[:-1]          
real = r_oil[250:]      

var_hist = np.percentile(past, 5, axis=1)
var_norm = past.mean(axis=1) - 1.645 * past.std(axis=1)

breach_hist = real < var_hist     
breach_norm = real < var_norm

print('исторический:',breach_hist.mean())
print('нормальный:',breach_norm.mean())

days = dates.astype("datetime64[D]")

plt.figure(figsize=(12, 5))
plt.plot(days[1:][19:], vol_year)
plt.title("Нефть Brent: скользящая волатильность (20 дней)")
plt.ylabel("Годовая волатильность")
plt.tight_layout()
plt.savefig("volatility.png", dpi=150)


plt.figure(figsize=(10, 5))
plt.hist(price_20_days, bins=60, alpha=0.5, label="Нормальная")
